{
  "policy_type": "ADMISSORIUM_EMERGENCY_STOP",
  "schema_version": "1.0.0",
  "canonical_switch": "ADMISSORIUM_WRITE_DISABLED",
  "when_active_disable": [
    "pr_creation",
    "issue_creation",
    "branch_writes",
    "projection_repair_writes",
    "quarantine_issue_writes"
  ],
  "when_active_preserve": [
    "audit_report_generation",
    "local_cli_operation",
    "read_only_graph_generation",
    "check_run_blocking_if_configured"
  ]
}
