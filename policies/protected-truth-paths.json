{
  "policy_type": "ADMISSORIUM_PROTECTED_TRUTH_PATHS",
  "schema_version": "1.0.0",
  "protected_paths": [
    "law/**",
    "laws/**",
    "freeze/**",
    "freezes/**",
    "current/**",
    "epochs/current/**",
    "state/current/**",
    "authorities/current/**",
    "receipts/current/**",
    "verification/results/current/**",
    "recognitions/current/**",
    "recourse/current/**",
    "claims/current/**",
    "continuity/current/**",
    "transfer/current/**",
    "LICENSE",
    "package.json",
    ".github/workflows/*release*"
  ],
  "if_touched": {
    "automatic_projection_repair_allowed": false,
    "direct_write_allowed": false,
    "required_decision": "GOVERNANCE_REVIEW_REQUIRED_OR_BLOCKED"
  }
}
