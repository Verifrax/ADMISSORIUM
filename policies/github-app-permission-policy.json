{
  "policy_type": "ADMISSORIUM_GITHUB_APP_PERMISSION_POLICY",
  "schema_version": "1.0.0",
  "allowed": {
    "metadata": "read",
    "contents": "read",
    "pull_requests": "write",
    "issues": "write",
    "checks": "write",
    "actions": "read",
    "pages": "read",
    "packages": "read",
    "commit_statuses": "write"
