{
  "name": "@verifrax/admissorium",
  "version": "0.6.0",
  "description": "Admissibility enforcement implementation for the VERIFRAX constitutional perimeter.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "admissorium": "./dist/cli/admissorium.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "audit": "node dist/cli/admissorium.js audit --org Verifrax",
    "test": "find dist/tests -type f -name '*.test.js' -print | sort | xargs node --test",
    "admissorium:v020": "node scripts/admissorium-v020-readiness.cjs",
    "check:v020": "node scripts/admissorium-v020-readiness.cjs",
    "check:v040": "node scripts/admissorium-v020-readiness.cjs",
    "check:control-plane": "node scripts/admissorium-v020-readiness.cjs",
    "v020:schema:validate": "node src/schema/validate-v020-objects.js",
    "v020:classify": "node src/v020/evaluate-candidate.js",
    "v020:verdict": "node src/v020/compile-verdict-receipt.js",
    "v020:quarantine": "node src/v020/route-quarantine-repair.js",
    "v020:operator-review": "node src/v020/compile-operator-review-bundle.js",
    "v020:writer-sim": "node src/v020/simulate-test-mode-writer.js",
    "v020:webhook": "node src/v020/verify-webhook-signature.js",
    "v020:hostile": "node src/v020/run-hostile-fixtures.js",
    "v020:report": "node src/v020/write-report-bundle.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0"
  }
}
