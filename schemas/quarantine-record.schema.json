{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADMISSORIUM Quarantine Record",
  "type": "object",
  "required": [
    "quarantine_record_type",
    "schema_version",
    "quarantine_id",
    "truth_warning",
    "subject",
    "quarantine_class",
    "reason",
    "required_repair",
    "deletion_allowed",
    "merge_effect"
  ],
  "additionalProperties": false,
  "properties": {
    "quarantine_record_type": {
      "const": "ADMISSORIUM_QUARANTINE_RECORD"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "quarantine_id": {
      "type": "string"
    },
    "truth_warning": {
      "const": "NOT_TRUTH_SOURCE"
    },
    "subject": {
      "type": "object"
    },
    "quarantine_class": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "required_repair": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "deletion_allowed": {
      "const": false
    },
    "merge_effect": {
      "type": "string"
    }
  }
}
