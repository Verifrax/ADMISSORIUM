{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADMISSORIUM Admission Receipt",
  "type": "object",
  "required": [
    "receipt_type",
    "schema_version",
    "receipt_id",
    "truth_warning",
    "subject",
    "inputs",
    "decision",
    "bounded_meaning",
    "history_snapshot",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "receipt_type": {
      "const": "ADMISSORIUM_ADMISSION_RECEIPT"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string"
    },
    "truth_warning": {
      "const": "NOT_TRUTH_SOURCE"
    },
    "subject": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "decision": {
      "type": "string"
    },
    "bounded_meaning": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "history_snapshot": {
      "type": "string"
    },
    "signature": {
      "type": "object"
    }
  }
}
