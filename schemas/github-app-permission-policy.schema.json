{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADMISSORIUM GitHub App Permission Policy",
  "type": "object",
  "required": [
    "policy_type",
    "schema_version",
    "allowed",
    "forbidden",
    "truth_warning"
  ],
  "additionalProperties": false,
  "properties": {
    "policy_type": {
      "const": "ADMISSORIUM_GITHUB_APP_PERMISSION_POLICY"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "allowed": {
      "type": "object"
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "truth_warning": {
      "const": "PERMISSION_TO_WRITE_TRUTH_IS_FORBIDDEN"
    }
  }
}
