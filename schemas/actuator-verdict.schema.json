{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADMISSORIUM Actuator Verdict",
  "type": "object",
  "required": [
    "verdict_type",
    "schema_version",
    "admissorium_version",
    "run_id",
    "truth_warning",
    "subject",
    "surface_classification",
    "policy_evaluation",
    "decision",
    "merge_effect",
    "forbidden_actions_confirmed_absent",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "verdict_type": {
      "const": "ADMISSORIUM_ACTUATOR_VERDICT"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "admissorium_version": {
      "const": "0.2.0"
    },
    "run_id": {
      "type": "string"
    },
    "truth_warning": {
      "const": "NOT_TRUTH_SOURCE"
    },
    "subject": {
      "type": "object"
    },
    "surface_classification": {
      "type": "object"
    },
    "policy_evaluation": {
      "type": "object"
    },
    "graph_evaluation": {
      "type": "object"
    },
    "decision": {
      "type": "string"
    },
    "merge_effect": {
      "type": "object"
    },
    "forbidden_actions_confirmed_absent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "signature": {
      "type": "object"
    }
  }
}
